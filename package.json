{
  "name": "translator",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: dịch text bôi đen bằng phím tắt, tooltip tại chỗ, Translator API on-device",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "puppeteer-core": "^23.0.0",
    "typescript": "^5.7.0"
  }
}
